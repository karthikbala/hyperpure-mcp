# Prefer `npm run configure`: it generates keys and binds your expected outlet.
PUBLIC_ORIGIN=https://hyperpure.example.com
HYPERPURE_MOBILE=YOUR_10_DIGIT_MOBILE
DATA_DIR=./data
MCP_TOKEN=GENERATE_A_RANDOM_32_BYTE_SECRET
OWNER_KEY=GENERATE_A_DIFFERENT_RANDOM_32_BYTE_SECRET
# binding.json in DATA_DIR is also required; the setup command creates it.
