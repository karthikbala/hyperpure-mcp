{
  "name": "hyperpure-mcp",
  "version": "0.4.0",
  "private": true,
  "description": "Single-account Hyperpure MCP with persistent browser and human OTP renewal",
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "configure": "node scripts/configure.mjs",
    "check": "node scripts/check.mjs",
    "check:public": "node scripts/check-public-files.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test test/*.test.js",
    "test:live": "node --env-file-if-exists=.env test/live-readonly.mjs"
  },
  "keywords": [
    "mcp",
    "hyperpure",
    "playwright",
    "procurement",
    "model-context-protocol"
  ],
  "author": "Karthik Bala",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.9.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "express": "5.2.1",
    "playwright": "1.63.0",
    "zod": "4.6.5"
  },
  "homepage": "https://github.com/karthikbala/hyperpure-mcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/karthikbala/hyperpure-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/karthikbala/hyperpure-mcp/issues"
  },
  "devDependencies": {
    "prettier": "3.9.9"
  }
}
