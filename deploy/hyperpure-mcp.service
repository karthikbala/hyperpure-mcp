[Unit]
Description=Hyperpure MCP persistent browser service
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=hyperpure-mcp
Group=hyperpure-mcp
WorkingDirectory=/opt/hyperpure-mcp
EnvironmentFile=/etc/hyperpure-mcp/service.env
Environment=PLAYWRIGHT_BROWSERS_PATH=/var/lib/hyperpure-mcp/browsers
ExecStart=/opt/hyperpure-mcp/runtime/bin/node src/server.js
Restart=on-failure
RestartSec=10
TimeoutStopSec=60
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/hyperpure-mcp
MemoryMax=3G
CPUQuota=150%
TasksMax=512

[Install]
WantedBy=multi-user.target
